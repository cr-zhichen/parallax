# Create a key at https://artificialanalysis.ai/ and keep it server-side.
ARTIFICIAL_ANALYSIS_API_KEY=

# Use "free" for the public field set or "pro" for the Pro+ endpoint.
ARTIFICIAL_ANALYSIS_API_TIER=free

# Persistent model snapshot path. Docker uses /app/data/model-catalog.json.
PARALLAX_CATALOG_CACHE_PATH=data/model-catalog.json
